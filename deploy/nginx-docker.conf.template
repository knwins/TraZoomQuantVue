server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Re-resolve Docker service names after upstream containers are recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_URL};

    # Security headers
    add_header Content-Security-Policy "frame-ancestors 'self';" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Static asset caching.
    #
    # Vite fingerprints everything under /assets/ (e.g.
    # AiDecisionRecords-BvUlkIcT.js), so those URLs are safe to pin for a
    # year: a content change produces a different filename.
    #
    # Files copied verbatim from public/ land at the site root with their
    # original names (slogo.png, logo.png, avatar2.jpg, robots.txt, ...).
    # Those are NOT fingerprinted, so a long immutable TTL pins the browser
    # to a stale copy even after the image is rebuilt and redeployed — the
    # classic "I changed the logo and nothing happened" trap. Serve them with
    # must-revalidate so the browser revalidates via ETag and picks up new
    # artwork on the next load, while still avoiding repeat downloads when
    # nothing changed.
    # `^~` is required here: a plain prefix `location /assets/` loses to the
    # regex below, because Nginx evaluates regex locations before prefix
    # matches (except "^~", which short-circuits that check). Without it every
    # fingerprinted file under /assets/ would still be served with the
    # must-revalidate rules meant for public/ assets.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$ {
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
        access_log off;
    }

    # API proxy to backend. ${BACKEND_URL} is substituted at container start by
    # the official nginx image's envsubst step (NGINX_ENVSUBST_FILTER pins it
    # to BACKEND_URL so $host/$remote_addr/etc. below stay literal).
    # docker-compose default: http://backend:5000
    # Railway: set BACKEND_URL=http://${{Backend.RAILWAY_PRIVATE_DOMAIN}}:5000
    #
    # `^~` is required: profile avatars are served as
    # `/api/users/avatars/{id}_{token}.png` (and jpg/webp). Without `^~`, the
    # static-extension regex above wins and nginx looks for those files under
    # the SPA root instead of proxying to Flask — uploads succeed but avatars
    # render as broken images (404).
    location ^~ /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 600s;  # 10 minutes for long-running backtests
        proxy_connect_timeout 75s;
        proxy_send_timeout 600s;  # 10 minutes for sending response
        # Allow large file uploads (e.g. indicator import)
        client_max_body_size 10m;
    }

    # Vue Router uses hash routes, so only the site root needs the app shell.
    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Health check endpoint
    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
        access_log off;
    }
}
